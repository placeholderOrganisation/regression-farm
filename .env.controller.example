# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=regression_farm

# --- Controller ---
# Generate with: openssl rand -hex 32
WORKER_TOKEN=replace_with_openssl_rand_hex_32

# Where logs/artifacts are written inside the controller container
LOG_DIR=/var/lib/regression-farm/logs
ARTIFACT_DIR=/var/lib/regression-farm/artifacts

# Days of logs/artifacts to retain (cleanup runs daily)
LOG_RETENTION_DAYS=30

# Default test workload prefix for seeded jobs
IMAGE_PREFIX=minteksoftware/regression-farm

# Flask
FLASK_ENV=production
LOG_LEVEL=INFO
