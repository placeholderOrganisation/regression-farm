# Address of the controller (use private VPC IP in production)
# In docker-compose.worker.yml on a DO worker droplet:
#   CONTROLLER_URL=http://<controller-private-ip>:8000
CONTROLLER_URL=http://controller:8000

# Must match WORKER_TOKEN in the controller .env
WORKER_TOKEN=replace_with_openssl_rand_hex_32

# Unique per droplet: worker-1, worker-2, worker-3, ...
WORKER_NAME=worker-1

# How often to poll the controller for the next job (seconds)
POLL_INTERVAL=2

# Optional capabilities advertised to the controller (JSON)
WORKER_CAPABILITIES={"os":"linux","arch":"amd64"}

LOG_LEVEL=INFO
